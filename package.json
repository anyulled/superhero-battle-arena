{
  "name": "superhero-battle-arena-harness",
  "version": "0.0.0",
  "private": true,
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": "24.20.0",
    "npm": "11.19.1"
  },
  "scripts": {
    "doctor": "node scripts/check-environment.mjs",
    "lint:commits": "commitlint",
    "lint:duplication": "jscpd --pattern '**/*.java' --ignore '**/.agents/**,**/.agent/**,**/.claude/**,**/.codex/**,**/target/**,**/node_modules/**' --threshold 10",
    "test:hooks": "sh scripts/tests/pre-commit-test.sh",
    "test:workflows": "ruby scripts/tests/workflow-gates-test.rb",
    "test:harness": "node --test scripts/tests/*.test.mjs && npm run test:hooks && npm run test:workflows",
    "test:postgres-startup": "node scripts/tests/postgres-startup-test.mjs",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@playwright/test": "1.63.0",
    "jscpd": "5.1.2",
    "yaml": "2.9.0"
  }
}
