description":"Number of the round","required":true,"schema":{"type":"integer","format":"int32"}},{"name":"teamId","in":"query","description":"ID of the team","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"Submission retrieved successfully","content":{"*/*":{"schema":{"$ref":"#/components/schemas/DraftSubmission"}}}},"404":{"description":"Submission or round not found","content":{"*/*":{"schema":{"$ref":"#/components/schemas/DraftSubmission"}}}}}}},"/api/matches":{"get":{"tags":["Match Management"],"summary":"List all matches","description":"Retrieves a list of all matches.","operationId":"getAllMatches","responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/Match"}}}}}}}},"/api/matches/{matchId}":{"get":{"tags":["Match Management"],"summary":"Get match details","description":"Retrieves detailed information about a specific match.","operationId":"getMatch","parameters":[{"name":"matchId","in":"path","description":"ID of the match","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"Match details found","content":{"*/*":{"schema":{"$ref":"#/components/schemas/Match"}}}},"404":{"description":"Match not found","content":{"*/*":{"schema":{"$ref":"#/components/schemas/Match"}}}}}}},"/api/matches/{matchId}/events":{"get":{"tags":["Match Management"],"summary":"Get match events","description":"Retrieves a list of all events that occurred during a match.","operationId":"getEvents","parameters":[{"name":"matchId","in":"path","description":"ID of the match","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"List of events retrieved","content":{"*/*":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/MatchEventSnapshot"}}}}}}}},"/api/matches/{matchId}/events/stream":{"get":{"tags":["Match Management"],"summary":"Stream match events","description":"Streams events for a match using Server-Sent Events (SSE).","operationId":"streamEvents","parameters":[{"name":"matchId","in":"path","description":"ID of the match to stream","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"$ref":"#/components/schemas/SseEmitter"}}}}}}},"/api/heroes":{"get":{"tags":["Heroes"],"summary":"List all heroes","description":"Get a list of all available heroes with pagination support","operationId":"getAllHeroes","parameters":[{"name":"page","in":"query","description":"Page number (0-based)","required":false,"schema":{"type":"integer","format":"int32","default":0}},{"name":"size","in":"query","description":"Page size","required":false,"schema":{"type":"integer","format":"int32","default":10}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/Hero"}}}}}}}},"/api/heroes/{id}":{"get":{"tags":["Heroes"],"summary":"Get hero by ID","description":"Get detailed information about a specific hero","operationId":"getHeroById","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int32"}}],"responses":{"200":{"description":"Hero found","content":{"*/*":{"schema":{"$ref":"#/components/schemas/Hero"}}}},"404":{"description":"Hero not found","content":{"*/*":{"schema":{"$ref":"#/components/schemas/Hero"}}}}}}},"/api/heroes/search":{"get":{"tags":["Heroes"],"summary":"Search heroes","description":"Search heroes by name (case-insensitive substring match)","operationId":"searchHeroes","parameters":[{"name":"q","in":"query","required":true,"schema":{"type":"string"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/Hero"}}}}}}}},"/api/heroes/search/advanced":{"get":{"tags":["Hero Search"],"summary":"Advanced hero search","description":"Search heroes with advanced filters, pagination, sorting, and HATEOAS links","operatio