{"openapi":"3.1.0","info":{"title":"OpenAPI definition","version":"v0"},"servers":[{"url":"https://superhero-battle-arena.barcelonajug.org"}],"tags":[{"name":"Match Management","description":"Endpoints for creating and simulating matches"},{"name":"Heroes","description":"API for browsing and searching superheroes"},{"name":"Session Management","description":"Endpoints for managing tournament sessions"},{"name":"Round Management","description":"Endpoints for managing rounds and submissions"},{"name":"Hero Search","description":"Advanced API for searching superheroes with filters"},{"name":"Team Management","description":"Endpoints for registering and viewing teams"},{"name":"Admin Management","description":"Privileged endpoints for tournament administration"}],"paths":{"/api/teams/register":{"post":{"tags":["Team Management"],"summary":"Register a team","description":"Registers a new team for the arena.","operationId":"registerTeam","parameters":[{"name":"name","in":"query","description":"Name of the team","required":true,"schema":{"type":"string"}},{"name":"members","in":"query","description":"List of hero names/IDs in the team","required":true,"schema":{"type":"array","items":{"type":"string"}}},{"name":"sessionId","in":"query","description":"Optional session ID","required":false,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"Team registered successfully","content":{"*/*":{"schema":{"type":"string","format":"uuid"}}}}}}},"/api/sessions":{"get":{"tags":["Session Management"],"summary":"List all sessions","description":"Returns all tournament sessions.","operationId":"listSessions","responses":{"200":{"description":"Sessions retrieved","content":{"*/*":{"schema":{"$ref":"#/components/schemas/Session"}}}}}},"post":{"tags":["Session Management"],"summary":"Create a new session","description":"Initializes a new tournament session.","operationId":"createSession","responses":{"200":{"description":"Session created","content":{"*/*":{"schema":{"$ref":"#/components/schemas/Session"}}}}}}},"/api/rounds/{roundNo}/submit":{"post":{"tags":["Round Management"],"summary":"Submit a team for a round","description":"Submits a draft team configuration for a specific round.","operationId":"submitTeam","parameters":[{"name":"roundNo","in":"path","description":"Number of the round","required":true,"schema":{"type":"integer","format":"int32"}},{"name":"teamId","in":"query","description":"ID of the team","required":true,"schema":{"type":"string","format":"uuid"}}],"requestBody":{"description":"Draft submission containing hero IDs and strategy","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DraftSubmission"}}},"required":true},"responses":{"200":{"description":"Team submitted successfully"},"400":{"description":"Invalid submission data"},"404":{"description":"Round not found"}}}},"/api/admin/sessions/start":{"post":{"tags":["Admin Management"],"summary":"Start a new session","description":"Initializes a new tournament session, optionally with a predefined UUID.","operationId":"startSession","parameters":[{"name":"sessionId","in":"query","description":"Optional custom session ID","required":false,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"Session started","content":{"*/*":{"schema":{"type":"string","format":"uuid"}}}}}}},"/api/admin/rounds/create":{"post":{"tags":["Admin Management"],"summary":"Create a custom round","description":"Creates a new round with specified constraints and specifications.","operationId":"createRound","requestBody":{"description":"Details for the new round","content":{"application/json":{"schema":{"$ref":"#/components/schemas/CreateRoundRequest"}}},"required":true},"responses":{"200":{"description":"Round created","content":{"*/*":{"schema":{"type":"integer","format":"int32"}}}}}}},"/api/admin/reset":{"post":{"tags":["Admin Management"],"summary":"Reset database","description":"DANGER: Clears all tournament data: sessions, rounds, match