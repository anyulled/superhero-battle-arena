ics of the hero"},"role":{"type":"string","description":"Combat role of the hero","example":"Tank"},"cost":{"type":"integer","format":"int32","description":"Cost of selecting this hero","example":15},"alignment":{"type":"string","description":"Alignment of the hero","example":"good"},"publisher":{"type":"string","description":"Publisher of the hero's comics","example":"DC Comics"},"appearance":{"$ref":"#/components/schemas/Appearance","description":"Physical appearance details"},"biography":{"$ref":"#/components/schemas/Biography","description":"Biographical details"},"tags":{"type":"array","description":"List of tags associated with the hero","example":["flying","super-strength"],"items":{"type":"string"}},"images":{"$ref":"#/components/schemas/Images","description":"URLs to hero images"},"_links":{"$ref":"#/components/schemas/Links"}}},"PageMetadata":{"type":"object","properties":{"size":{"type":"integer","format":"int64"},"totalElements":{"type":"integer","format":"int64"},"totalPages":{"type":"integer","format":"int64"},"number":{"type":"integer","format":"int64"}}},"PagedModelEntityModelHero":{"type":"object","properties":{"_embedded":{"type":"object","properties":{"heroList":{"type":"array","items":{"$ref":"#/components/schemas/EntityModelHero"}}}},"_links":{"$ref":"#/components/schemas/Links"},"page":{"$ref":"#/components/schemas/PageMetadata"}}},"RoundConstraintOptions":{"type":"object","description":"Available superhero values for round constraints","properties":{"roles":{"type":"array","items":{"type":"string"}},"genders":{"type":"array","items":{"type":"string"}},"races":{"type":"array","items":{"type":"string"}},"publishers":{"type":"array","items":{"type":"string"}},"alignments":{"type":"array","items":{"type":"string"}}}},"Link":{"type":"object","properties":{"href":{"type":"string"},"hreflang":{"type":"string"},"title":{"type":"string"},"type":{"type":"string"},"deprecation":{"type":"string"},"profile":{"type":"string"},"name":{"type":"string"},"templ