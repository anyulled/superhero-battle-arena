","required":false,"schema":{"type":"integer","format":"int32"}},{"name":"minDurability","in":"query","description":"Minimum durability","required":false,"schema":{"type":"integer","format":"int32"}},{"name":"maxDurability","in":"query","description":"Maximum durability","required":false,"schema":{"type":"integer","format":"int32"}},{"name":"minCombat","in":"query","description":"Minimum combat","required":false,"schema":{"type":"integer","format":"int32"}},{"name":"maxCombat","in":"query","description":"Maximum combat","required":false,"schema":{"type":"integer","format":"int32"}},{"name":"page","in":"query","description":"Page number (0-based)","required":false,"schema":{"type":"integer","format":"int32","default":0},"example":0},{"name":"size","in":"query","description":"Page size (1-100)","required":false,"schema":{"type":"integer","format":"int32","default":20},"example":20},{"name":"sortBy","in":"query","description":"Sort field (name, cost, power, speed)","required":false,"schema":{"type":"string"}},{"name":"sortDirection","in":"query","description":"Sort direction (ASC, DESC)","required":false,"schema":{"type":"string","enum":["ASC","DESC"]}}],"responses":{"200":{"description":"Search completed successfully","content":{"*/*":{"schema":{"$ref":"#/components/schemas/PagedModelEntityModelHero"}}}}}}},"/api/heroes/filter":{"get":{"tags":["Heroes"],"summary":"Filter heroes","description":"Filter heroes by alignment and/or publisher","operationId":"filterHeroes","parameters":[{"name":"alignment","in":"query","required":false,"schema":{"type":"string"}},{"name":"publisher","in":"query","required":false,"schema":{"type":"string"}}],"responses":{"200":{"description":"OK","content":{"*/*":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/Hero"}}}}}}}},"/api/admin/sessions":{"get":{"tags":["Admin Management"],"summary":"List all sessions","description":"Retrieves a list of all current and past tournament sessions.","operationId":"listSessions_1","response